{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "deny",
      "main-agent": "allow",
      "sub-agent": "allow",
      "evolution-agent": "allow",
      "sub-e-agent": "allow",
      "optics-mie-reproduction": "allow",
      "optics-magnus-platform": "allow",
      "optics-magnus-artifacts": "allow",
      "pdf": "allow",
      "magnus": "allow",
      "optics-agent-core": "allow",
      "skill-creator": "ask"
    },
    "task": {
      "*": "deny",
      "sepr-main": "allow",
      "sepr-sub": "allow",
      "sepr-evolution": "allow",
      "sepr-sub-e": "allow"
    },
    "external_directory": {
      "*": "ask",
      "C:/Users/27370/Desktop/project/self-evo-paper-repro/**": "allow"
    }
  },
  "agent": {
    "sepr-main": {
      "description": "SEPR paper-reproduction orchestrator. Use for starting or continuing a new paper/figure reproduction workflow.",
      "mode": "primary",
      "maxTurns": 50,
      "prompt": "{file:.opencode/prompts/sepr-main.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "bash": "ask",
        "skill": {
          "main-agent": "allow",
          "sub-agent": "allow",
          "optics-mie-reproduction": "allow",
          "optics-magnus-platform": "allow",
          "optics-magnus-artifacts": "allow",
          "*": "ask"
        },
        "task": {
          "*": "deny",
          "sepr-sub": "allow",
          "sepr-sub-leaf": "allow"
        }
      }
    },
    "sepr-sub": {
      "description": "SEPR paper-reproduction execution subagent for one assigned workflow step.",
      "mode": "subagent",
      "maxTurns": 15,
      "prompt": "{file:.opencode/prompts/sepr-sub.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": {
          "sub-agent": "allow",
          "optics-mie-reproduction": "allow",
          "optics-magnus-platform": "allow",
          "optics-magnus-artifacts": "allow",
          "*": "ask"
        },
        "task": {
          "*": "deny",
          "sepr-sub-leaf": "allow"
        },
        "edit": "ask",
        "bash": "ask"
      }
    },
    "sepr-evolution": {
      "description": "SEPR self-iteration orchestrator. Use only when the user explicitly starts an evolution/self-iteration run.",
      "mode": "primary",
      "maxTurns": 50,
      "prompt": "{file:.opencode/prompts/sepr-evolution.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "ask",
        "bash": "ask",
        "skill": {
          "evolution-agent": "allow",
          "sub-e-agent": "allow",
          "skill-creator": "ask",
          "*": "ask"
        },
        "task": {
          "*": "deny",
          "sepr-sub-e": "allow",
          "sepr-sub-e-leaf": "allow"
        }
      }
    },
    "sepr-sub-e": {
      "description": "SEPR self-iteration execution subagent for one assigned evolution step.",
      "mode": "subagent",
      "maxTurns": 15,
      "prompt": "{file:.opencode/prompts/sepr-sub-e.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": {
          "sub-e-agent": "allow",
          "skill-creator": "ask",
          "*": "ask"
        },
        "task": {
          "*": "deny",
          "sepr-sub-e-leaf": "allow"
        },
        "edit": "ask",
        "bash": "ask"
      }
    },
    "sepr-sub-leaf": {
      "description": "SEPR paper-reproduction leaf subsubagent for one single-point task. Must not launch further agents.",
      "mode": "subagent",
      "maxTurns": 15,
      "prompt": "{file:.opencode/prompts/sepr-sub-leaf.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": {
          "sub-agent": "allow",
          "optics-mie-reproduction": "allow",
          "optics-magnus-platform": "allow",
          "optics-magnus-artifacts": "allow",
          "*": "ask"
        },
        "task": "deny",
        "edit": "ask",
        "bash": "ask"
      }
    },
    "sepr-sub-e-leaf": {
      "description": "SEPR self-iteration leaf subsubagent for one single-point evolution task. Must not launch further agents.",
      "mode": "subagent",
      "maxTurns": 15,
      "prompt": "{file:.opencode/prompts/sepr-sub-e-leaf.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": {
          "sub-e-agent": "allow",
          "skill-creator": "ask",
          "*": "ask"
        },
        "task": "deny",
        "edit": "ask",
        "bash": "ask"
      }
    }
  }
}
