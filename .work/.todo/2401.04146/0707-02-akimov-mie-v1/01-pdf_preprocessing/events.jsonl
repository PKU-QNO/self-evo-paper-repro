array}\r\n0374: \t\\caption{Normalized absorption cross-section with respective contributions of the TM and TE fields with $l=1,2$ for (a)--(c) a silver particle of $R=25$ nm and (d)--(f) a silicon particle of $R=40$ nm embedded in silicon dioxide. The limits in (b) and (e) are given by $\\sigma_{{\\rm abs},l}^{\\rm sa}$.\r\n0375: \t\\label{Fig8}}\r\n0382: \\section{Limitations}\r\n0387: \\subsection{Excitation source}\r\n0391: \t\\caption{Ratios $\\eta_{\\rm sca}$ of the modified scattering cross-section contributions given by Eq.~(\\ref{S_sca_source}) to the classical ones for the TM and TE scattered fields with $l=1,2,3$ under $q_e=1$ and $\\varepsilon_i/\\varepsilon_e=5+\\i~0.1$.\r\n0392: \t\\label{Fig9}}\r\n0396: \\begin{eqnarray}\r\n0401: \\end{eqnarray}\r\n0403: \\begin{eqnarray}\r\n0407: \\label{a_l_ext}\\\\\r\n0411: \\label{b_l_ext}\r\n0412: \\end{eqnarray}\r\n0417: \t\\caption{Ratios $\\eta_{\\rm abs}$ of the modified absorption cross-section contributions given by Eq.~(\\ref{S_abs_source}) to the classical ones for the TM and TE scattered fields with $l=1,2,3$ under $q_e=1$ and $\\varepsilon_i/\\varepsilon_e=5+\\i~0.1$.\r\n0418: \t\\label{Fig10}}\r\n0421: \\begin{eqnarray}\r\n0426: \\end{eqnarray}\r\n0428: \\begin{eqnarray}\r\n0433: \\\\&\\label{S_sca_source}\\\\\r\n0439: \t|a_l|^2(1-|\\alpha_l|^2)-|b_l|^2(1-|\\beta_l|^2)].\\label{S_abs_source}\r\n0440: \\end{eqnarray} \r\n0443: \\subsection{Sphere interface}\r\n0447: \\begin{eqnarray}\r\n0449: \t\\vec F^{\\rm opt}=\\frac{1}{2}{\\rm Re}\\int (\\rho^*\\vec E^{\\rm inc}+\\mu_0\\vec J^*\\times\\vec H^{\\rm inc})\\d V.\\label{F_opt}\r\n0450: \\end{eqnarray} \r\n0452: \\begin{eqnarray}\r\n0455: \\end{eqnarray} \r\n0457: \\begin{eqnarray}\r\n0460: \\end{eqnarray} \r\n0462: \\begin{eqnarray}\r\n0465: \\end{eqnarray} \r\n0467: \\begin{eqnarray}\r\n0469: \\end{eqnarray} \r\n0477: \\begin{eqnarray}\r\n0481: \t\\hspace{4cm}\\frac{1}{\\varepsilon(r)}\\frac{\\d \\varepsilon(r)}{\\d r}\\frac{\\d(r  H_{lm})}{\\d r},\\label{WEd_H_inh}\\\\\r\n0483: \t\t\\frac{\\d^2 (rE_{lm})}{\\d r^2}-\\left[\\frac{l(l+1)}{r^2}-k_0^2\\varepsilon(r)\\right](rE_{lm})=0. \\label{WEd_E_inh}\r\n0484: \\end{eqnarray}\r\n0486: \\begin{eqnarray}\r\n0491: \\end{eqnarray}\r\n0493: \\begin{eqnarray}\r\n0496: \\label{Z_H}\\\\\r\n0499: \\label{Y_E}\r\n0500: \\end{eqnarray}\r\n0502: \\begin{eqnarray}\r\n0506: \\label{a_l_tra}\\\\\r\n0510: \\label{b_l_tra}\r\n0511: \\end{eqnarray}\r\n0513: \\begin{eqnarray}\r\n0518: \\end{eqnarray} \r\n0522: \\begin{equation}\r\n0524: \\end{equation} \r\n0526: \\begin{equation}\r\n0528: \\end{equation} \r\n0533: \t\\caption{Ratios $\\eta_{\\rm sca}$ of the modified scattering cross-section contributions given by scattering coefficients (\\ref{a_l_tra}) and (\\ref{b_l_tra}) to the classical ones for the TM and TE scattered fields with $l=1,2,3$ under $k_0(R_i+R_e)/2=1$, $\\varepsilon_e=2.25$, ${\\rm Im}~\\varepsilon_i=0.1$ for linear profiles of $\\varepsilon(r)$.\r\n0534: \t\\label{Fig11}}\r\n0539: \\subsection{Scatterer localization}\r\n0555: \t\\caption{Ratios $\\eta_{\\rm abs}$ of the modified absorption cross-section contributions given by scattering coefficients Eqs.~(\\ref{a_l_tra}) and (\\ref{b_l_tra}) to the classical ones for the TM and TE scattered fields with $l=1,2,3$ under $k_0(R_i+R_e)/2=1$, $\\varepsilon_e=2.25$, ${\\rm Im}~\\varepsilon_i=0.1$ for linear profiles of $\\varepsilon(r)$.\r\n0556: \t\\label{Fig12}}\r\n0564: \\section{Conclusion}\r\n","exit_code":0,"status":"completed"}}
