{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nimport re\nfrom pathlib import Path\ntex=Path('01-pdf_preprocessing/src/Text-rev.tex').read_text(encoding='utf-8',errors='replace')\n# remove comments? no, figure blocks no comments inside captions likely\nfig_blocks=[]\nfor m in re.finditer(r'\\\\\\\\begin\\\\{figure\\\\}.*?\\\\\\\\end\\\\{figure\\\\}', tex, flags=re.S):\n    block=m.group(0)\n    line=tex[:m.start()].count('\\\\n')+1\n    inc=re.search(r'\\\\\\\\includegraphics(?:\\\\[[\"'^'\"\\\\]]*\\\\])?\\\\{([\"'^}]+)'\"\\\\}', block)\n    # brace parser for caption\n    idx=block.find('\\\\\\\\caption')\n    cap=''\n    if idx\"'!=-1:\n        brace=block.find('\"'{', idx)\n        depth=0; chars=[]\n        for ch in block[brace+1:]:\n            if ch=='{': depth+=1; chars.append(ch)\n            elif ch=='}':\n                if depth==0: break\n                depth-=1; chars.append(ch)\n            else: chars.append(ch)\n        cap=''.join(chars).strip()\n    label=re.search(r'\\\\\\\\label\\\\{([\"'^}]+)'\"\\\\}', block)\n    fig_blocks.append((line, inc.group(1) if inc else '', label.group(1) if label else '', cap))\nfor i,(line,inc,label,cap) in enumerate(fig_blocks,1):\n    print('\\\\n'+'='*80)\n    print(f'Fig{i} line {line} include={inc} label={label}')\n    print(cap)\nprint('\\\\nTOTAL',len(fig_blocks))\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
